:root {
  font-family: "DM Sans", sans-serif;
  color: #eef0fb;
  background: #090a12;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --bg: #090a12;
  --panel: #11121d;
  --panel-raised: #151623;
  --border: rgba(165, 165, 195, .13);
  --muted: #898ba2;
  --soft: #b6b8ca;
  --purple: #a58bff;
  --cyan: #54dfd1;
  --danger: #ff6a87;
  --amber: #ffbf69;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--bg); }
button, input { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible, tr:focus-visible { outline: 2px solid #9c85ff; outline-offset: 3px; }
.app-shell { min-height: 100vh; }

.sidebar-container { position: fixed; z-index: 20; inset: 0 auto 0 0; width: 252px; }
.sidebar { display: flex; flex-direction: column; height: 100%; padding: 27px 16px 18px; background: #0c0d16; border-right: 1px solid rgba(165,165,195,.1); }
.brand { display: flex; align-items: center; gap: 11px; padding: 0 8px; }
.brand-mark { display: grid; width: 36px; height: 36px; place-items: center; color: #d3c7ff; border: 1px solid rgba(171,143,255,.35); border-radius: 11px; background: linear-gradient(145deg, rgba(142,110,255,.23), rgba(54,225,209,.1)); box-shadow: 0 0 22px rgba(141,110,255,.13); }
.brand-name { display: block; font-family: "Space Grotesk", sans-serif; font-size: 15px; font-weight: 700; letter-spacing: .16em; }
.brand-caption { display: block; padding-top: 3px; color: #74778d; font-family: "DM Mono", monospace; font-size: 8px; letter-spacing: .115em; }
.workspace-switcher { display: flex; align-items: center; gap: 10px; height: 58px; margin: 34px 0 29px; padding: 9px; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(110deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); }
.workspace-avatar { display: grid; width: 33px; height: 33px; place-items: center; border-radius: 8px; color: #d9ceff; background: linear-gradient(135deg,#5945a0,#272640); font-family: "Space Grotesk", sans-serif; font-weight: 700; }
.workspace-copy { min-width: 0; flex: 1; }
.workspace-copy strong,.workspace-copy span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-copy strong { font-size: 11px; font-weight: 600; }
.workspace-copy span { margin-top: 3px; color: #777a90; font-size: 10px; }
.workspace-chevron { color: #82849a; font-size: 16px; }
.nav-heading { padding: 0 11px 10px; color: #62657b; font-family: "DM Mono", monospace; font-size: 9px; letter-spacing: .12em; }
.sidebar-nav { display: grid; gap: 5px; }
.nav-item { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 11px; color: #999bae; border: 1px solid transparent; border-radius: 8px; background: transparent; text-align: left; font-size: 12px; cursor: pointer; transition: .18s ease; }
.nav-item:hover { color: #e5e3f1; background: rgba(255,255,255,.035); }
.nav-item.active { color: #e0d7ff; border-color: rgba(154,125,255,.18); background: linear-gradient(90deg,rgba(142,110,255,.16),rgba(142,110,255,.05)); box-shadow: inset 2px 0 #a88dff; }
.nav-item.active svg { color: #b9a5ff; }
.nav-count { margin-left: auto; }
.sidebar-spacer { flex: 1; }
.sidebar-bottom { display: grid; gap: 17px; }
.sidebar-note { display: flex; gap: 10px; padding: 13px 10px; border: 1px solid rgba(139,118,225,.15); border-radius: 9px; background: radial-gradient(ellipse at 2% 0%,rgba(128,101,220,.13),transparent 80%); }
.note-icon { color: #bca9ff; }
.sidebar-note strong { font-size: 10px; font-weight: 600; }
.sidebar-note p { margin: 4px 0 0; color: #84869b; font-size: 10px; line-height: 1.5; }
.connection-status { display: flex; align-items: center; gap: 7px; padding: 0 7px; color: #9a9daf; font-size: 10px; }
.api-location { margin-left: auto; color: #62657a; font-family: "DM Mono", monospace; }
.status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: #77798c; }
.status-dot.online { background: #56dcb9; box-shadow: 0 0 9px rgba(86,220,185,.48); }
.status-dot.offline { background: #ff7889; box-shadow: 0 0 8px rgba(255,120,137,.4); }
.sidebar-footer { display: flex; justify-content: space-between; padding: 13px 7px 0; color: #5e6174; border-top: 1px solid rgba(165,165,195,.09); font-family: "DM Mono", monospace; font-size: 8px; letter-spacing: .04em; }

.main-content { min-height: 100vh; margin-left: 252px; }
.topbar { position: sticky; z-index: 10; top: 0; display: flex; align-items: center; justify-content: space-between; min-height: 82px; padding: 0 42px; border-bottom: 1px solid rgba(165,165,195,.1); background: rgba(9,10,18,.88); backdrop-filter: blur(20px); }
.page-heading h1 { margin: 0; font-family: "Space Grotesk", sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -.02em; }
.page-heading p { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
.topbar-right { display: flex; align-items: center; gap: 20px; }
.environment-pill { display: flex; align-items: center; gap: 8px; padding: 7px 9px; color: #9b9db0; border: 1px solid rgba(165,165,195,.13); border-radius: 6px; font-family: "DM Mono", monospace; font-size: 8px; letter-spacing: .06em; }
.environment-pill .status-dot { width: 6px; height: 6px; }
.user-avatar { display: grid; width: 32px; height: 32px; place-items: center; color: #d2c8ff; border: 1px solid rgba(166,145,255,.28); border-radius: 50%; background: rgba(131,105,222,.15); font-size: 10px; font-weight: 700; }
.mobile-menu,.mobile-close { display: none !important; }
.page-content { max-width: 1510px; margin: 0 auto; padding: 22px 42px 25px; }
.backend-banner { display: flex; align-items: center; gap: 8px; min-height: 34px; margin-bottom: 18px; padding: 0 11px; color: #a4a6b8; border: 1px solid rgba(165,165,195,.1); border-radius: 7px; background: rgba(255,255,255,.018); font-size: 10px; }
.backend-banner .status-dot { width: 6px; height: 6px; }
.backend-url { color: #696c80; font-family: "DM Mono", monospace; font-size: 9px; }
.backend-help { margin-left: auto; color: #dcae71; font-size: 10px; }

.scan-card { position: relative; overflow: hidden; margin-bottom: 27px; padding: 24px 25px 17px; border: 1px solid rgba(168,144,255,.2); border-radius: 12px; background: radial-gradient(ellipse at 94% 4%,rgba(91,74,160,.2),transparent 36%),linear-gradient(120deg,#151421 0%,#11121d 55%,#11141d 100%); box-shadow: 0 12px 45px rgba(0,0,0,.13); }
.scan-card::before { position: absolute; top: -1px; left: 28px; width: 72px; height: 2px; background: linear-gradient(90deg,transparent,#aa91ff,transparent); content: ""; }
.scan-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow,.section-kicker { color: #9b8ad3; font-family: "DM Mono", monospace; font-size: 9px; letter-spacing: .12em; }
.eyebrow { display: flex; align-items: center; gap: 7px; }
.eyebrow-line { width: 15px; height: 1px; background: #a68aff; }
.scan-card h2 { margin: 9px 0 4px; font-family: "Space Grotesk", sans-serif; font-size: 21px; font-weight: 600; letter-spacing: -.03em; }
.scan-card-top p { margin: 0; color: #9294a8; font-size: 11px; }
.scan-orb { display: grid; width: 42px; height: 42px; place-items: center; margin: 3px 4px 0 0; color: #beaeff; border: 1px solid rgba(168,144,255,.22); border-radius: 12px; background: rgba(141,116,237,.11); box-shadow: 0 0 26px rgba(141,116,237,.1); }
.scan-form { display: flex; align-items: center; gap: 11px; height: 52px; margin-top: 20px; padding: 5px 6px 5px 15px; border: 1px solid rgba(168,144,255,.31); border-radius: 8px; background: #0d0e17; box-shadow: 0 0 0 3px rgba(143,115,239,.035); }
.input-icon { flex: 0 0 auto; color: #89809f; }
.scan-form input { width: 100%; min-width: 0; height: 100%; padding: 0; color: #f0eff7; border: 0; outline: 0; background: transparent; font-size: 12px; }
.scan-form input::placeholder { color: #686a7c; }
.scan-form input:focus-visible { outline: none; }
.scan-button { display: flex; flex: 0 0 auto; align-items: center; gap: 8px; height: 38px; padding: 0 12px; color: #fff; border: 1px solid rgba(186,163,255,.35); border-radius: 6px; background: linear-gradient(120deg,#765bd3,#7254bb); box-shadow: 0 3px 12px rgba(111,83,197,.21); font-size: 11px; font-weight: 600; cursor: pointer; transition: .16s ease; }
.scan-button:hover:not(:disabled) { transform: translateY(-1px); background: linear-gradient(120deg,#856ce3,#805fc9); }
.scan-button:disabled { opacity: .8; cursor: wait; }
.button-shortcut { display: grid; width: 17px; height: 17px; place-items: center; margin-left: 2px; color: #ddd4fa; border: 1px solid rgba(255,255,255,.2); border-radius: 4px; font-size: 12px; }
.clear-input { display: grid; flex: 0 0 auto; width: 26px; height: 26px; place-items: center; color: #74768c; border: 0; border-radius: 5px; background: transparent; cursor: pointer; }
.clear-input:hover { color: #f4f3fa; background: rgba(255,255,255,.06); }
.spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.35); border-top-color: white; border-radius: 50%; animation: spin .7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.scan-assurance { display: flex; align-items: center; gap: 11px; margin-top: 13px; color: #76798d; font-size: 9px; }
.scan-assurance span:first-child { display: flex; align-items: center; gap: 5px; color: #898aa0; }
.assurance-divider { width: 2px; height: 2px; border-radius: 50%; background: #57596d; }
.inline-error { display: flex; align-items: center; gap: 7px; margin-top: 11px; color: #ff9aa8; font-size: 11px; }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 0 13px; }
.section-heading h2,.panel-header h2 { margin: 0; font-family: "Space Grotesk", sans-serif; font-size: 14px; font-weight: 600; }
.section-heading p,.panel-header p { margin: 4px 0 0; color: #84869a; font-size: 10px; }
.live-tag { display: flex; align-items: center; gap: 7px; color: #717487; font-family: "DM Mono", monospace; font-size: 8px; letter-spacing: .07em; }
.live-tag .status-dot { width: 5px; height: 5px; }
.metrics-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; margin-bottom: 16px; }
.metric-card { position: relative; min-height: 128px; padding: 15px 15px 13px; overflow: hidden; border: 1px solid var(--border); border-radius: 9px; background: linear-gradient(140deg,rgba(255,255,255,.032),rgba(255,255,255,.012)); }
.metric-icon { display: grid; width: 29px; height: 29px; place-items: center; margin-bottom: 10px; border: 1px solid rgba(165,165,195,.13); border-radius: 8px; }
.metric-icon.purple { color: #b69fff; background: rgba(152,121,255,.11); }
.metric-icon.cyan { color: #63dbcf; background: rgba(67,205,186,.09); }
.metric-icon.amber { color: #edbb74; background: rgba(242,179,93,.09); }
.metric-icon.pink { color: #e88bb2; background: rgba(224,115,162,.09); }
.metric-label { position: absolute; top: 20px; left: 54px; color: #898b9f; font-family: "DM Mono", monospace; font-size: 8px; letter-spacing: .08em; }
.metric-value { font-family: "Space Grotesk", sans-serif; font-size: 21px; font-weight: 600; letter-spacing: -.04em; }
.metric-caption { margin-top: 5px; color: #777a8e; font-size: 9px; }

.content-grid { display: grid; grid-template-columns: minmax(0,1.52fr) minmax(270px,.88fr); gap: 14px; }
.panel { min-width: 0; border: 1px solid var(--border); border-radius: 9px; background: linear-gradient(150deg,rgba(255,255,255,.025),rgba(255,255,255,.01)); }
.recent-panel,.intelligence-panel { min-height: 263px; }
.panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 67px; padding: 14px 16px; border-bottom: 1px solid rgba(165,165,195,.09); }
.panel-live-mark { display: grid; width: 24px; height: 24px; place-items: center; border: 1px solid rgba(86,220,185,.13); border-radius: 7px; background: rgba(86,220,185,.05); }
.panel-live-mark .status-dot { width: 5px; height: 5px; }
.text-button { display: inline-flex; align-items: center; gap: 5px; padding: 0; color: #b8a5ff; border: 0; background: none; font-size: 10px; cursor: pointer; }
.text-button:hover { color: #d0c3ff; }
.text-button.compact { font-size: 9px; }
.table-scroll { overflow-x: auto; }
.scan-table { width: 100%; border-collapse: collapse; text-align: left; }
.scan-table th { padding: 10px 12px; color: #65687d; border-bottom: 1px solid rgba(165,165,195,.08); font-family: "DM Mono", monospace; font-size: 8px; font-weight: 400; letter-spacing: .08em; white-space: nowrap; }
.scan-table th:first-child,.scan-table td:first-child { padding-left: 16px; }
.scan-table td { height: 52px; padding: 8px 12px; color: #a9aabc; border-bottom: 1px solid rgba(165,165,195,.07); font-size: 10px; }
.scan-table tbody tr { cursor: pointer; transition: background .15s ease; }
.scan-table tbody tr:hover { background: rgba(165,145,255,.055); }
.scan-table tbody tr:last-child td { border-bottom: 0; }
.table-domain { display: flex; align-items: center; gap: 9px; min-width: 128px; }
.table-favicon { display: grid; flex: 0 0 auto; width: 28px; height: 28px; place-items: center; color: #a494df; border: 1px solid rgba(165,145,255,.13); border-radius: 7px; background: rgba(165,145,255,.07); }
.table-domain strong,.table-domain small { display: block; max-width: 165px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.table-domain strong { color: #d2d2df; font-size: 10px; font-weight: 500; }
.table-domain small { margin-top: 3px; color: #6f7184; font-size: 8px; }
.table-verdict { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
.table-verdict .status-dot,.verdict-pill .status-dot { width: 5px; height: 5px; }
.table-verdict.safe { color: #67d7b4; }
.table-verdict.safe .status-dot,.verdict-pill.safe .status-dot { background: #5bd3aa; }
.table-verdict.warning { color: #edbd77; }
.table-verdict.warning .status-dot,.verdict-pill.warning .status-dot { background: #edbd77; }
.table-verdict.danger { color: #f27b94; }
.table-verdict.danger .status-dot,.verdict-pill.danger .status-dot { background: #f27b94; }
.table-score { font-family: "DM Mono", monospace; font-size: 10px; }
.table-score small { margin-left: 2px; color: #707286; font-size: 8px; }
.table-score.safe { color: #74d9b8; }.table-score.warning { color: #edbd77; }.table-score.danger { color: #f27b94; }
.table-date { color: #808295 !important; white-space: nowrap; font-size: 9px !important; }
.table-chevron { color: #626579; }
.count-chip { padding: 5px 8px; color: #a9a1ca; border: 1px solid rgba(165,145,255,.15); border-radius: 5px; background: rgba(165,145,255,.06); font-family: "DM Mono",monospace; font-size: 9px; white-space: nowrap; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 180px; padding: 24px 20px; text-align: center; }
.empty-icon { display: grid; width: 40px; height: 40px; place-items: center; margin-bottom: 10px; color: #9684d3; border: 1px solid rgba(165,145,255,.15); border-radius: 11px; background: rgba(165,145,255,.06); }
.empty-state h3 { margin: 0; color: #d7d6e2; font-family: "Space Grotesk",sans-serif; font-size: 12px; font-weight: 500; }
.empty-state p { max-width: 250px; margin: 6px 0 0; color: #818397; font-size: 10px; line-height: 1.55; }
.empty-state .text-button { margin-top: 13px; }

.threat-summary { padding: 15px; }
.threat-domain-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.threat-domain-icon { display: grid; width: 32px; height: 32px; place-items: center; color: #82d8d0; border: 1px solid rgba(84,223,209,.13); border-radius: 8px; background: rgba(84,223,209,.06); }
.threat-domain-row strong,.threat-domain-row span { display: block; }
.threat-domain-row strong { color: #d8d8e4; font-size: 10px; font-weight: 500; }
.threat-domain-row span { margin-top: 4px; color: #7d8093; font-family: "DM Mono",monospace; font-size: 8px; }
.threat-model-box { padding: 11px; border: 1px solid rgba(165,145,255,.12); border-radius: 7px; background: rgba(165,145,255,.035); }
.model-label { display: flex; align-items: center; gap: 6px; color: #9994ae; font-family: "DM Mono",monospace; font-size: 8px; letter-spacing: .06em; }
.model-spark { display: inline-flex; color: #b3a0ff; }
.classification { margin-left: auto; font-family: "DM Sans",sans-serif; font-size: 9px; font-weight: 600; letter-spacing: 0; }
.classification.safe { color: #70d7b5; }.classification.warning { color: #ebbd7a; }.classification.danger { color: #f27b94; }
.model-bar,.probability-track { overflow: hidden; height: 4px; margin-top: 11px; border-radius: 5px; background: rgba(255,255,255,.07); }
.model-bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#65d6bf,#c5a7ff,#fa738e); }
.model-foot { display: flex; justify-content: space-between; margin-top: 7px; color: #77798d; font-size: 9px; }
.model-foot strong { color: #c5c3d2; font-family: "DM Mono",monospace; font-size: 9px; font-weight: 500; }
.intel-facts { display: grid; grid-template-columns: repeat(3,1fr); margin: 14px -2px 0; }
.intel-facts div { padding: 0 8px; border-right: 1px solid rgba(165,165,195,.1); }
.intel-facts div:first-child { padding-left: 2px; }.intel-facts div:last-child { border: 0; }
.intel-facts span,.intel-facts strong { display: block; }
.intel-facts span { color: #77798d; font-size: 8px; }
.intel-facts strong { margin-top: 5px; color: #c8c8d6; font-family: "DM Mono",monospace; font-size: 10px; font-weight: 500; }
.text-good { color: #62d6b3 !important; }.text-warn { color: #f0b976 !important; }
.intel-disclaimer { margin-top: 13px; padding-top: 10px; color: #737589; border-top: 1px solid rgba(165,165,195,.08); font-size: 8px; line-height: 1.5; }
.inline-note { display: flex; align-items: flex-start; gap: 6px; margin-top: 10px; color: #dda966; font-size: 9px; line-height: 1.45; }
.inline-note svg { flex: 0 0 auto; }
.page-footer { display: flex; justify-content: space-between; gap: 15px; margin-top: 23px; padding-top: 13px; color: #585b6e; border-top: 1px solid rgba(165,165,195,.08); font-family: "DM Mono",monospace; font-size: 8px; letter-spacing: .02em; }

.result-card { margin-bottom: 17px; overflow: hidden; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(155deg,rgba(255,255,255,.03),rgba(255,255,255,.012)); }
.result-header { display: flex; align-items: center; justify-content: space-between; padding: 17px 19px; border-bottom: 1px solid rgba(165,165,195,.09); }
.result-title-wrap { display: flex; align-items: center; gap: 10px; }
.result-status-icon { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid rgba(165,165,195,.14); border-radius: 9px; }
.result-status-icon.safe { color: #68d5b3; background: rgba(85,207,168,.08); }.result-status-icon.warning { color: #eab96f; background: rgba(238,178,97,.08); }.result-status-icon.danger { color: #f27891; background: rgba(241,102,134,.08); }
.result-title-wrap h2 { margin: 3px 0 0; font-family: "Space Grotesk",sans-serif; font-size: 14px; font-weight: 600; }
.result-title-wrap .section-kicker { font-size: 8px; }
.timestamp { display: flex; align-items: center; gap: 6px; color: #77798d; font-size: 9px; }
.result-main { display: flex; align-items: center; gap: 30px; padding: 17px 20px; }
.risk-score { position: relative; display: flex; flex: 0 0 123px; flex-direction: column; align-items: center; justify-content: center; height: 126px; }
.risk-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
.risk-ring circle { fill: none; stroke-width: 7; }
.risk-track { stroke: rgba(255,255,255,.075); }
.risk-progress { stroke: #59d5b5; stroke-linecap: round; transition: stroke-dashoffset .6s ease; }
.risk-score.warning .risk-progress { stroke: #edb96f; }.risk-score.danger .risk-progress { stroke: #f06b88; }
.risk-score-number { display: flex; align-items: baseline; margin-top: 5px; font-family: "Space Grotesk",sans-serif; }
.risk-score-number strong { font-size: 29px; font-weight: 600; letter-spacing: -.07em; }
.risk-score-number span { margin-left: 3px; color: #76798e; font-family: "DM Mono",monospace; font-size: 9px; }
.risk-score-label { margin-top: 1px; color: #7a7c90; font-family: "DM Mono",monospace; font-size: 7px; letter-spacing: .12em; }
.result-summary { min-width: 0; }
.verdict-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; border: 1px solid rgba(165,165,195,.14); border-radius: 5px; background: rgba(255,255,255,.025); font-size: 9px; font-weight: 600; }
.verdict-pill.safe { color: #6dd9b6; border-color: rgba(86,220,185,.17); background: rgba(86,220,185,.05); }
.verdict-pill.warning { color: #ebbd77; border-color: rgba(235,189,119,.18); background: rgba(235,189,119,.05); }
.verdict-pill.danger { color: #f47e96; border-color: rgba(244,126,150,.17); background: rgba(244,126,150,.05); }
.scanned-domain { overflow: hidden; margin: 9px 0 3px; color: #e4e3ed; font-family: "Space Grotesk",sans-serif; font-size: 17px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.scanned-url { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; overflow: hidden; color: #8d8fa4; font-family: "DM Mono",monospace; font-size: 9px; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
.scanned-url:hover { color: #b9a8ff; }
.result-message { margin: 9px 0 0; color: #a2a3b5; font-size: 10px; }
.status-conflict { margin: 7px 0 0; color: #e8bb78; font-size: 9px; }
.disclaimer { margin: 5px 0 0; color: #6f7184; font-size: 9px; line-height: 1.5; }
.result-divider { height: 1px; margin: 0 19px; background: rgba(165,165,195,.09); }
.result-details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 16px 20px; }
.detail-heading { display: flex; align-items: center; gap: 7px; color: #85879a; font-family: "DM Mono",monospace; font-size: 8px; letter-spacing: .075em; }
.detail-heading-icon { display: grid; width: 23px; height: 23px; place-items: center; border-radius: 6px; }
.detail-heading-icon.purple { color: #b6a2ff; background: rgba(165,145,255,.1); }.detail-heading-icon.cyan { color: #6cdbd0; background: rgba(84,223,209,.08); }.detail-heading-icon.amber { color: #eabc78; background: rgba(235,189,119,.08); }
.detail-primary { margin: 9px 0 9px 30px; color: #d1d0dd; font-family: "Space Grotesk",sans-serif; font-size: 13px; font-weight: 500; }
.probability-row { display: flex; justify-content: space-between; margin-left: 30px; color: #7b7d91; font-size: 9px; }
.probability-row strong { color: #c2b5ed; font-family: "DM Mono",monospace; font-size: 9px; font-weight: 500; }
.probability-track { height: 3px; margin: 7px 0 0 30px; }
.probability-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#64d6b8,#c5a7ff,#f57993); }
.legitimate-row { margin-top: 9px; }
.legitimate-row strong { color: #74d9b8; }
.legitimate-track { margin-top: 6px; }
.legitimate-track span { background: linear-gradient(90deg,#429c8a,#67d9b6); }
.dns-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-left: 30px; }
.dns-tag { padding: 4px 6px; color: #8eddd5; border: 1px solid rgba(84,223,209,.13); border-radius: 4px; background: rgba(84,223,209,.04); font-family: "DM Mono",monospace; font-size: 8px; }
.dns-tag b { margin-left: 5px; color: #c3c6d5; font-weight: 500; }
.muted-copy { color: #75778b; font-size: 9px; }
.dns-error { margin: 7px 0 0 30px; color: #dcae71; font-size: 9px; line-height: 1.4; }
.finding-section { padding: 0 20px 16px; }
.finding-count { display: grid; min-width: 17px; height: 17px; place-items: center; margin-left: 1px; color: #aaa1c7; border: 1px solid rgba(165,145,255,.13); border-radius: 5px; font-family: "DM Sans",sans-serif; font-size: 8px; }
.finding-list { display: grid; gap: 8px; margin: 11px 0 0 30px; padding: 0; list-style: none; }
.finding-list li { display: flex; align-items: flex-start; gap: 8px; color: #b2b2c1; font-size: 10px; line-height: 1.4; }
.finding-bullet { flex: 0 0 auto; width: 5px; height: 5px; margin-top: 4px; border-radius: 50%; background: #e8ad66; box-shadow: 0 0 7px rgba(232,173,102,.4); }
.clean-finding { display: flex; align-items: center; gap: 7px; margin: 11px 0 0 30px; color: #70d2b1; font-size: 10px; }
.transport-strip { display: flex; align-items: center; gap: 10px; margin: 0 16px 15px; padding: 10px 11px; border: 1px solid rgba(165,165,195,.1); border-radius: 7px; background: rgba(255,255,255,.018); }
.transport-icon { display: grid; flex: 0 0 auto; width: 26px; height: 26px; place-items: center; border-radius: 7px; }
.transport-icon.good { color: #63d4b0; background: rgba(86,220,185,.08); }.transport-icon.attention { color: #e9b46b; background: rgba(235,189,119,.08); }
.transport-strip div { flex: 1; }
.transport-strip strong,.transport-strip div span { display: block; }
.transport-strip strong { color: #c8c7d4; font-size: 9px; font-weight: 500; }
.transport-strip div span { margin-top: 3px; color: #7b7d90; font-size: 8px; line-height: 1.4; }
.transport-state { color: #64d5b2; font-family: "DM Mono",monospace; font-size: 8px; }
.transport-state.attention { color: #e9b46b; }
.full-panel { min-height: 330px; }
.scanner-empty { display: flex; min-height: 218px; flex-direction: column; align-items: center; justify-content: center; padding: 26px; text-align: center; }
.scanner-empty h2 { margin: 2px 0 0; font-family: "Space Grotesk",sans-serif; font-size: 14px; font-weight: 600; }
.scanner-empty p { max-width: 390px; margin: 7px 0 0; color: #85879a; font-size: 10px; line-height: 1.55; }
.scanner-loading .spinner { width: 23px; height: 23px; margin-bottom: 12px; border-color: rgba(165,145,255,.2); border-top-color: #b7a3ff; }
.dashboard-latest-result { margin-top: 22px; }
.dashboard-latest-result .section-heading { align-items: center; }
.full-panel > .panel-header { min-height: 73px; }
.ssl-layout { display: grid; grid-template-columns: minmax(0,.84fr) minmax(0,1.16fr); gap: 14px; }
.ssl-hero-panel,.cert-panel { padding: 18px; }
.ssl-hero-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px; }
.ssl-large-icon { display: grid; width: 49px; height: 49px; place-items: center; border: 1px solid rgba(86,220,185,.18); border-radius: 13px; }
.ssl-large-icon.good { color: #63d4b0; background: rgba(86,220,185,.08); }.ssl-large-icon.attention { color: #e9b46b; border-color: rgba(235,189,119,.18); background: rgba(235,189,119,.07); }
.ssl-hero-panel .section-kicker { color: #8f86ad; font-size: 8px; }
.ssl-hero-panel h2 { margin: 8px 0; font-family: "Space Grotesk",sans-serif; font-size: 18px; font-weight: 600; line-height: 1.3; }
.ssl-host { overflow-wrap: anywhere; color: #87899c; font-family: "DM Mono",monospace; font-size: 9px; }
.ssl-status-banner { display: flex; align-items: flex-start; gap: 8px; margin-top: 20px; padding: 11px; color: #9ea0b3; border: 1px solid rgba(165,165,195,.11); border-radius: 7px; background: rgba(255,255,255,.02); font-size: 9px; line-height: 1.5; }
.ssl-status-banner svg { flex: 0 0 auto; color: #6bd5b5; }
.ssl-hero-panel:has(.attention) .ssl-status-banner svg { color: #e9b46b; }
.cert-panel { padding: 0; }
.cert-panel .panel-header { padding: 15px 17px; }
.metadata-label { color: #7e7996; font-family: "DM Mono",monospace; font-size: 8px; letter-spacing: .08em; }
.cert-details { display: grid; padding: 3px 17px 11px; }
.cert-details div { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 37px; border-bottom: 1px solid rgba(165,165,195,.07); font-size: 9px; }
.cert-details div:last-child { border-bottom: 0; }
.cert-details span { color: #8b8da0; }
.cert-details strong { color: #c9c8d5; font-weight: 500; text-align: right; }
.cert-details .unavailable-value { color: #828396; font-size: 8px; font-weight: 400; }
.scope-notice { display: flex; gap: 8px; margin: 0 14px 14px; padding: 10px; color: #b69a70; border: 1px solid rgba(225,172,99,.13); border-radius: 6px; background: rgba(225,172,99,.04); }
.scope-notice svg { flex: 0 0 auto; margin-top: 1px; }
.scope-notice p { margin: 0; font-size: 8px; line-height: 1.55; }
.intel-page { display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 14px; }
.intel-main-panel,.intel-findings-panel { min-height: 280px; }
.intel-source { display: flex; align-items: center; gap: 5px; color: #9e8ce0; font-family: "DM Mono",monospace; font-size: 8px; }
.intel-findings-panel .clean-finding { margin-top: 21px; }
.expanded-findings { display: grid; gap: 0; margin: 0; padding: 0 16px; list-style: none; }
.expanded-findings li { display: flex; align-items: flex-start; gap: 10px; padding: 13px 0; color: #b5b4c3; border-bottom: 1px solid rgba(165,165,195,.07); font-size: 10px; line-height: 1.5; }
.expanded-findings li > span:nth-child(2) { flex: 1; }
.expanded-findings li > svg { flex: 0 0 auto; color: #727589; }
.data-source-note { margin: 15px 16px; color: #77798d; font-size: 9px; line-height: 1.55; }
.toast-aria { position: fixed; bottom: 0; left: 0; width: 1px; height: 1px; overflow: hidden; }

@media (min-width: 1500px) {
  .page-content { padding-right: 54px; padding-left: 54px; }
  .scan-card { padding: 28px 30px 19px; }
  .metrics-grid { gap: 15px; }
  .metric-card { min-height: 136px; padding: 17px 18px; }
}
@media (max-width: 1180px) {
  .topbar { padding-right: 28px; padding-left: 28px; }
  .page-content { padding-right: 28px; padding-left: 28px; }
  .content-grid { grid-template-columns: minmax(0,1.25fr) minmax(255px,.9fr); }
  .scan-table th:nth-child(4),.scan-table td:nth-child(4) { display: none; }
  .metrics-grid { gap: 9px; }
  .metric-card { padding-right: 11px; padding-left: 11px; }
}
@media (max-width: 920px) {
  .sidebar-container { width: 246px; transform: translateX(-100%); transition: transform .22s ease; }
  .sidebar-container.open { transform: translateX(0); }
  .sidebar { box-shadow: 15px 0 45px rgba(0,0,0,.35); }
  .main-content { margin-left: 0; }
  .mobile-menu { display: grid !important; margin-right: 12px; }
  .mobile-close { display: grid !important; margin-left: auto; }
  .topbar { justify-content: flex-start; }
  .topbar-right { margin-left: auto; }
  .mobile-backdrop { position: fixed; z-index: 19; inset: 0; border: 0; background: rgba(3,4,9,.68); backdrop-filter: blur(2px); }
  .content-grid { grid-template-columns: minmax(0,1.2fr) minmax(250px,.8fr); }
}
@media (max-width: 690px) {
  .topbar { min-height: 70px; padding: 0 17px; }
  .page-heading h1 { font-size: 15px; }
  .page-heading p { max-width: 230px; overflow: hidden; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .topbar-right { gap: 10px; }
  .environment-pill { padding: 6px; font-size: 0; }
  .environment-pill .status-dot { width: 7px; height: 7px; }
  .user-avatar { width: 29px; height: 29px; }
  .page-content { padding: 15px 15px 20px; }
  .backend-banner { flex-wrap: wrap; gap: 6px; padding: 8px; font-size: 9px; }
  .backend-url { font-size: 8px; }
  .backend-help { flex-basis: 100%; margin-left: 14px; font-size: 9px; }
  .scan-card { margin-bottom: 22px; padding: 19px 15px 14px; }
  .scan-card h2 { font-size: 19px; }
  .scan-card-top p { max-width: 245px; line-height: 1.5; }
  .scan-orb { width: 36px; height: 36px; }
  .scan-form { gap: 8px; height: 48px; margin-top: 17px; padding-left: 11px; }
  .scan-form input { font-size: 11px; }
  .scan-button { gap: 6px; height: 36px; padding: 0 9px; font-size: 10px; }
  .button-shortcut { display: none; }
  .scan-assurance { flex-wrap: wrap; gap: 7px; font-size: 8px; }
  .metrics-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
  .metric-card { min-height: 115px; padding: 12px; }
  .metric-icon { width: 26px; height: 26px; margin-bottom: 9px; }
  .metric-label { top: 17px; left: 47px; font-size: 7px; }
  .metric-value { font-size: 19px; }
  .metric-caption { font-size: 8px; }
  .section-heading { align-items: flex-start; gap: 8px; }
  .live-tag { margin-top: 3px; font-size: 7px; }
  .content-grid,.ssl-layout,.intel-page { grid-template-columns: 1fr; }
  .recent-panel,.intelligence-panel { min-height: initial; }
  .page-footer { flex-direction: column; gap: 6px; font-size: 7px; line-height: 1.4; }
  .result-header { padding: 13px; }
  .timestamp { max-width: 115px; font-size: 8px; }
  .result-main { gap: 15px; padding: 15px 13px; }
  .risk-score { flex-basis: 106px; height: 110px; }
  .result-details-grid { gap: 11px; padding: 14px 13px; }
  .finding-section { padding-right: 13px; padding-left: 13px; }
  .transport-strip { margin-right: 10px; margin-left: 10px; padding: 9px; }
  .scanned-domain { font-size: 15px; }
  .result-message { font-size: 9px; line-height: 1.45; }
  .disclaimer { font-size: 8px; }
  .detail-heading { font-size: 7px; }
  .detail-primary { margin-left: 0; font-size: 12px; }
  .probability-row,.dns-summary { margin-left: 0; }
  .probability-track { margin-left: 0; }
  .clean-finding,.finding-list { margin-left: 0; }
  .full-panel { min-height: 280px; }
  .ssl-hero-panel,.cert-panel { padding: 15px; }
  .cert-panel { padding: 0; }
}
@media (max-width: 420px) {
  .page-content { padding-right: 11px; padding-left: 11px; }
  .scan-orb { display: none; }
  .scan-assurance { font-size: 7px; }
  .assurance-divider { display: none; }
  .metric-label { left: 44px; font-size: 6px; }
  .table-domain strong { max-width: 103px; }
  .scan-table th,.scan-table td { padding-right: 8px; padding-left: 8px; }
  .scan-table th:first-child,.scan-table td:first-child { padding-left: 10px; }
  .result-main { align-items: flex-start; gap: 12px; }
  .risk-score { flex-basis: 90px; height: 96px; }
  .risk-score-number strong { font-size: 24px; }
  .risk-score-label { font-size: 6px; }
  .result-details-grid { grid-template-columns: 1fr; gap: 15px; }
  .result-details-grid .detail-block + .detail-block { padding-top: 13px; border-top: 1px solid rgba(165,165,195,.08); }
  .timestamp svg { display: none; }
}
