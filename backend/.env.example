# Optional provider credentials. Leave blank to report those sources as unavailable.
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=

# OpenPhish's public feed endpoint; no key is required by this integration.
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# Moderation is disabled when this is blank. If enabled, use a private,
# high-entropy ASCII token between 32 and 256 characters.
COMMUNITY_REPORT_ADMIN_TOKEN=

# Use true only when the API is served over HTTPS.
COMMUNITY_REPORT_COOKIE_SECURE=false

# Certificate-monitor checks run every six hours by default.
CERTIFICATE_MONITOR_INTERVAL_SECONDS=21600
